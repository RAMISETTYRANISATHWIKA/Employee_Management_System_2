# Server environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/employee_manage
# For MongoDB Atlas, use a connection string like:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/employee_manage

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional initial accounts used by the seeders
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_STAFF_EMAIL=staff@example.com
